#!/usr/bin/env bash
# vscode-memory-watch — find out which VS Code process is eating your RAM.
#
# VS Code is a tree of 30+ processes that mostly share one binary and one name,
# so "VS Code is using 20 GB" tells you nothing you can act on. This samples the
# tree on an interval and records memory per tier, so the tier that climbs names
# itself, and it captures a full per-process snapshot at the moment things go
# bad — before a window reload destroys the evidence.
#
# Usage:
#   vscode-memory-watch            sample continuously (daemon mode)
#   vscode-memory-watch --once     print one reading and exit
#   vscode-memory-watch --report   growth per tier since the current run started
#   vscode-memory-watch --help
#
# Design notes:
#   - Reports PSS, not RSS. RSS counts every shared mapping once per process, so
#     summing it across a 30-process Electron tree overstates real usage badly.
#   - Finds processes by walking the tree from the VS Code main process down,
#     rather than pattern-matching command lines. That keeps it working across
#     VS Code, Code - OSS, VSCodium, Cursor, Windsurf and code-server, none of
#     which agree on install paths or user-data directory names.
#   - Per-process work is pure bash reading /proc — no forks, no subshells, no
#     external commands. Sampling cost does not grow with the size of the tree,
#     which is what makes it cheap enough to leave running.
#   - Deliberately avoids `pgrep -f`, whose pattern would match this script's own
#     command line and count the watcher as part of what it is watching.

set -u

readonly VERSION=1.1.0

readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/vscode-memory-watch"
readonly HISTORY="$STATE_DIR/history.csv"
readonly SNAP_DIR="$STATE_DIR/snapshots"

INTERVAL="${VSCODE_MEM_INTERVAL:-60}"             # seconds between samples
WARN_TOTAL_MB="${VSCODE_MEM_WARN_TOTAL:-12000}"   # whole-tree PSS warning line
WARN_PROC_MB="${VSCODE_MEM_WARN_PROC:-4000}"      # single-process PSS warning line
NOTIFY_COOLDOWN="${VSCODE_MEM_COOLDOWN:-1800}"    # seconds between notifications
readonly MAX_HISTORY_BYTES=$((5 * 1024 * 1024))

# statm counts pages, not kilobytes, and the page size is not 4K everywhere:
# arm64 kernels are commonly built with 16K pages, which would make every
# figure four times too small.
PAGE_KB=$(( $(getconf PAGESIZE 2>/dev/null || echo 4096) / 1024 ))
readonly PAGE_KB

# Reported in this order. The CSV header and every data row are generated from
# this one list, so a new tier cannot desynchronise them.
readonly TIERS=(
    renderer exthost claude tsserver langserver
    helper nodeutil utility gpu main zygote
)

# ---------------------------------------------------------------------------
# /proc readers. These set globals instead of echoing, because command
# substitution forks a subshell and this runs once per process per sample.
# ---------------------------------------------------------------------------

CMD=""
read_cmdline() {
    local arg
    CMD=""
    while IFS= read -r -d '' arg; do
        CMD+="$arg "
    done <"/proc/$1/cmdline" 2>/dev/null
}

# PSS divides each shared page among the processes mapping it, which is the only
# way the tiers add up to something meaningful. smaps_rollup carries a single
# Pss: line; when it is unreadable (a short-lived process, or a kernel without
# CONFIG_PROC_PAGE_MONITOR) we fall back to RSS and mark the figure rather than
# quietly reporting RSS under a PSS heading.
MEM_KB=0 PSS_EXACT=0
read_mem() {
    local key val rest
    PSS_EXACT=0 MEM_KB=0
    while read -r key val rest; do
        if [[ $key == Pss: ]]; then
            MEM_KB=$val PSS_EXACT=1
            return
        fi
    done <"/proc/$1/smaps_rollup" 2>/dev/null
    read_rss "$1"
    MEM_KB=$RSS_KB
}

RSS_KB=0
read_rss() {
    local size resident rest
    RSS_KB=0
    read -r size resident rest <"/proc/$1/statm" 2>/dev/null || return
    [[ $resident == +([0-9]) ]] && RSS_KB=$(( resident * PAGE_KB ))
}

# ---------------------------------------------------------------------------
# Classification
# ---------------------------------------------------------------------------

# Command lines that identify the top of a VS Code process tree. Everything else
# is found by descending from here.
is_root() {
    local cmd="$1" comm="$2"
    # Chromium children all carry --type=; a main process never does.
    [[ $cmd == *"--type="* ]] && return 1
    case "$cmd" in
        */code.mjs*|*server-main.js*|*/out/main.js*) return 0 ;;
    esac
    # Flavours whose main process is a bare executable with no revealing args.
    case "$comm" in
        code|code-oss|code-insiders|codium|vscodium|cursor|windsurf) return 0 ;;
    esac
    return 1
}

ROLE=""
classify() {
    case "$1" in
        *native-binary/claude*)              ROLE=claude ;;
        *tsserver.js*|*typingsInstaller.js*) ROLE=tsserver ;;
        *[Ss]erverMain*|*[Ss]erver.js*|*language-features*|*languageserver*)
                                             ROLE=langserver ;;
        *--type=zygote*)                     ROLE=zygote ;;
        *--type=gpu-process*)                ROLE=gpu ;;
        *--type=renderer*)                   ROLE=renderer ;;
        *--type=utility*)
            case "$1" in
                *node.mojom.NodeService*)
                    # Extension host, shared process, pty host and file watcher
                    # are all NodeService utilities with near-identical command
                    # lines. Only the extension host is started with a debug
                    # port, which is what separates it from its siblings.
                    case "$1" in
                        *--inspect-port*|*--experimental-network-inspection*)
                             ROLE=exthost ;;
                        *)   ROLE=nodeutil ;;
                    esac ;;
                *)   ROLE=utility ;;
            esac ;;
        *--type=*)                           ROLE=utility ;;
        # Anything else is a process an extension spawned: a tool server, a
        # language runtime, an integrated terminal shell. Not "main" — only a
        # root is main, and the caller assigns that.
        *)                                   ROLE=helper ;;
    esac
}

# ---------------------------------------------------------------------------
# Sampling
# ---------------------------------------------------------------------------

# Results of the most recent sample. Globals rather than a parsed stdout line so
# that a snapshot's header and its process table always describe the same
# instant — taking a second sample to fill in the detail would not.
declare -A TIER_KB=()
declare -a DETAIL=()
SUM_PSS_KB=0 SUM_RSS_KB=0 N_PROCS=0 N_CLAUDE=0 N_FALLBACK=0
TOP_ROLE=- TOP_PID=0 TOP_KB=0 ROOT_IDS=-

sample() {
    local -A ppid_of=() comm_of=() kids_of=() seen=()
    local -a roots=() queue=()
    local d pid stat rest comm tag i j tmp

    TIER_KB=() DETAIL=()
    SUM_PSS_KB=0 SUM_RSS_KB=0 N_PROCS=0 N_CLAUDE=0 N_FALLBACK=0
    TOP_ROLE=- TOP_PID=0 TOP_KB=0 ROOT_IDS=-

    # Pass one: parent and name for every process. The comm field is
    # parenthesised and may itself contain spaces or brackets, so the remainder
    # is taken from the last ") " rather than by field index.
    for d in /proc/[0-9]*; do
        pid=${d#/proc/}
        stat=$(<"$d/stat") 2>/dev/null || continue
        [[ -n $stat ]] || continue
        rest=${stat##*\) }
        rest=${rest#* }                 # drop state, leaving ppid first
        ppid_of[$pid]=${rest%% *}
        comm=${stat#*\(}
        comm_of[$pid]=${comm%%\)*}
    done

    # Pass two: find the roots. Only processes whose name suggests a VS Code
    # flavour are expanded, so this stays cheap on a busy machine.
    for pid in "${!comm_of[@]}"; do
        case "${comm_of[$pid]}" in
            electron|code|code-oss|code-insiders|codium|vscodium|cursor|windsurf|node) ;;
            *) continue ;;
        esac
        read_cmdline "$pid"
        [[ -n $CMD ]] || continue
        is_root "$CMD" "${comm_of[$pid]}" && roots+=("$pid")
    done

    ((${#roots[@]})) || return 0

    # Insertion sort, so the recorded identity of a run is stable between
    # samples regardless of the order bash walked the hash.
    for ((i = 1; i < ${#roots[@]}; i++)); do
        tmp=${roots[i]}
        for ((j = i - 1; j >= 0 && roots[j] > tmp; j--)); do
            roots[j + 1]=${roots[j]}
        done
        roots[j + 1]=$tmp
    done
    printf -v ROOT_IDS '%s;' "${roots[@]}"
    ROOT_IDS=${ROOT_IDS%;}
    local -A is_root=()
    for pid in "${roots[@]}"; do is_root[$pid]=1; done

    for pid in "${!ppid_of[@]}"; do
        kids_of[${ppid_of[$pid]}]+=" $pid"
    done

    # Pass three: breadth-first over the descendants of each root. Membership by
    # descent rather than by command-line pattern is what makes this work on
    # forks of VS Code that rename their directories and user-data paths.
    # (The crash-handler process is reparented to init and so is not counted;
    # it is a couple of megabytes.)
    queue=("${roots[@]}")
    while ((${#queue[@]})); do
        pid=${queue[0]}
        queue=("${queue[@]:1}")
        [[ -n ${seen[$pid]:-} ]] && continue
        seen[$pid]=1
        if [[ -n ${kids_of[$pid]:-} ]]; then
            # shellcheck disable=SC2206  # deliberate split of the child list
            queue+=(${kids_of[$pid]})
        fi

        read_cmdline "$pid"
        [[ -n $CMD ]] || continue
        read_mem "$pid"
        (( MEM_KB > 0 )) || continue
        read_rss "$pid"
        (( PSS_EXACT )) || N_FALLBACK=$(( N_FALLBACK + 1 ))

        if [[ -n ${is_root[$pid]:-} ]]; then ROLE=main; else classify "$CMD"; fi
        SUM_PSS_KB=$(( SUM_PSS_KB + MEM_KB ))
        SUM_RSS_KB=$(( SUM_RSS_KB + RSS_KB ))
        N_PROCS=$(( N_PROCS + 1 ))
        TIER_KB[$ROLE]=$(( ${TIER_KB[$ROLE]:-0} + MEM_KB ))
        [[ $ROLE == claude ]] && N_CLAUDE=$(( N_CLAUDE + 1 ))

        if (( MEM_KB > TOP_KB )); then
            TOP_KB=$MEM_KB TOP_PID=$pid TOP_ROLE=$ROLE
        fi

        tag=""
        case "$CMD" in
            *--resume=*) tag=${CMD#*--resume=}; tag="session=${tag%% *}" ;;
            *vscode-window-config=*) tag=window ;;
        esac
        (( PSS_EXACT )) || tag="${tag:+$tag }(rss estimate)"
        printf -v tmp '%9d KB pss  %9d KB rss  %-10s pid=%-8s %s' \
            "$MEM_KB" "$RSS_KB" "$ROLE" "$pid" "$tag"
        DETAIL+=("$tmp")
    done

    # Largest first: the whole point is to see the offender at the top.
    ((${#DETAIL[@]})) && mapfile -t DETAIL < <(printf '%s\n' "${DETAIL[@]}" | sort -rn)
    return 0
}

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

summary_head() {
    printf 'VS Code tree: %d MB PSS (%d MB RSS) across %d processes, %d Claude session(s)\n' \
        "$(( SUM_PSS_KB / 1024 ))" "$(( SUM_RSS_KB / 1024 ))" "$N_PROCS" "$N_CLAUDE"
}

summary_body() {
    local t out=""
    for t in "${TIERS[@]}"; do
        (( ${TIER_KB[$t]:-0} )) && out+="$t=$(( TIER_KB[$t] / 1024 ))MB "
    done
    printf '%s\n' "${out% }"
    printf 'largest: %s pid=%s at %d MB\n' "$TOP_ROLE" "$TOP_PID" "$(( TOP_KB / 1024 ))"
    (( N_FALLBACK )) && printf 'note: %d process(es) had no readable smaps_rollup; RSS used instead\n' "$N_FALLBACK"
    return 0
}

csv_header() {
    local h="timestamp,epoch,root_pids,total_pss_mb,total_rss_mb,pss_fallback,procs,claude_procs" t
    for t in "${TIERS[@]}"; do h+=",${t}_mb"; done
    printf '%s\n' "$h,top_role,top_pid,top_mb"
}

csv_row() {
    local row t stamp epoch
    printf -v stamp '%(%Y-%m-%dT%H:%M:%S%z)T' -1
    printf -v epoch '%(%s)T' -1
    row="$stamp,$epoch,$ROOT_IDS,$(( SUM_PSS_KB / 1024 )),$(( SUM_RSS_KB / 1024 ))"
    row+=",$N_FALLBACK,$N_PROCS,$N_CLAUDE"
    for t in "${TIERS[@]}"; do row+=",$(( ${TIER_KB[$t]:-0} / 1024 ))"; done
    printf '%s\n' "$row,$TOP_ROLE,$TOP_PID,$(( TOP_KB / 1024 ))"
}

usage() {
    cat <<USAGE
vscode-memory-watch $VERSION — find out which VS Code process is eating your RAM

  vscode-memory-watch            sample continuously, logging to
                                 \$XDG_STATE_HOME/vscode-memory-watch/history.csv
  vscode-memory-watch --once     print one reading and exit
  vscode-memory-watch --report   growth per tier since the current run started
  vscode-memory-watch --help     this text
  vscode-memory-watch --version

Environment:
  VSCODE_MEM_INTERVAL    seconds between samples          (default $INTERVAL)
  VSCODE_MEM_WARN_TOTAL  whole-tree PSS warning line, MB  (default $WARN_TOTAL_MB)
  VSCODE_MEM_WARN_PROC   single-process PSS line, MB      (default $WARN_PROC_MB)
  VSCODE_MEM_COOLDOWN    seconds between notifications    (default $NOTIFY_COOLDOWN)
USAGE
}

case "${1:-}" in
    -h|--help)    usage; exit 0 ;;
    -V|--version) printf 'vscode-memory-watch %s\n' "$VERSION"; exit 0 ;;
    --once)
        sample
        if (( N_PROCS == 0 )); then
            echo "No VS Code process tree found. Looked for a main process of:" >&2
            echo "VS Code, Code - OSS, VSCodium, Cursor, Windsurf or code-server." >&2
            exit 1
        fi
        summary_head
        summary_body | sed 's/^/  /'
        echo
        printf '%s\n' "${DETAIL[@]}"
        exit 0 ;;
    --report)
        [[ -s $HISTORY ]] || { echo "no history yet: $HISTORY" >&2; exit 1; }
        exec awk -F, -v interval="$INTERVAL" '
            NR == 1 {
                for (i = 1; i <= NF; i++) { idx[$i] = i; name[i] = $i }
                ncol = NF
                # Columns are looked up by name so tiers can be added without
                # touching this code, but the few the logic depends on have to
                # be there. An older log predating a schema change lands here.
                if (!("epoch" in idx) || !("root_pids" in idx) || \
                    !("total_pss_mb" in idx)) {
                    print "history file has an unrecognised header; it predates" > "/dev/stderr"
                    print "this version. Move it aside and let a new one start." > "/dev/stderr"
                    bad = 1
                    exit 2
                }
                next
            }
            {
                # A new run starts when the set of main processes changes, and
                # only then. That is the one signal that actually means the heap
                # under observation was thrown away. Testing the total instead
                # would misfire every time somebody closed a few heavy tabs, and
                # splitting on a gap in the log would discard the whole curve
                # every time the machine slept — on a laptop that is nightly,
                # and the memory survives sleep, so the run genuinely continues.
                gap = (prev_epoch > 0) ? $(idx["epoch"]) - prev_epoch : 0
                if (n > 0 && $(idx["root_pids"]) != prev_roots) { n = 0; gaps = 0 }
                # Gaps are still excluded from the rate: hours the watcher was
                # not running are hours the tree cannot be said to have grown in.
                else if (gap > 5 * interval) gaps += gap - interval
                prev_roots = $(idx["root_pids"]); prev_epoch = $(idx["epoch"])

                n++
                if (n == 1) {
                    t0 = $1; e0 = $(idx["epoch"])
                    # Reset the peaks too: carrying them across a restart would
                    # report an old run high-water mark against a new run.
                    for (i = 1; i <= ncol; i++) { first[i] = $i; peak[i] = $i }
                }
                for (i = 1; i <= ncol; i++) {
                    last[i] = $i
                    if ($i + 0 > peak[i] + 0) peak[i] = $i
                }
                t1 = $1; e1 = $(idx["epoch"]); samples = n
            }
            END {
                if (bad) exit 2
                if (samples == 0) { print "no samples in current run"; exit 1 }
                printf "current run: %s -> %s (%d samples, %d min)\n\n", \
                    t0, t1, samples, (e1 - e0) / 60 + 0.5
                printf "%-12s %10s %10s %10s %11s\n", "tier", "start", "now", "peak", "growth"
                for (i = 1; i <= ncol; i++) {
                    # top_mb is the largest single process, not a tier of its
                    # own; listing it here would double-count it in the table.
                    if (name[i] !~ /_mb$/ || name[i] == "top_mb") continue
                    label = name[i]; sub(/_mb$/, "", label)
                    if (first[i] + 0 == 0 && peak[i] + 0 == 0) continue
                    printf "%-12s %8d MB %8d MB %8d MB %+9d MB\n", \
                        label, first[i], last[i], peak[i], last[i] - first[i]
                }
                printf "\nprocesses: %d -> %d   claude sessions: %d -> %d\n", \
                    first[idx["procs"]], last[idx["procs"]], \
                    first[idx["claude_procs"]], last[idx["claude_procs"]]
                printf "largest process now: %s pid %s at %d MB (peak %d MB)\n", \
                    last[idx["top_role"]], last[idx["top_pid"]], \
                    last[idx["top_mb"]], peak[idx["top_mb"]]
                if (last[idx["pss_fallback"]] + 0 > 0)
                    printf "note: %d process(es) in the last sample fell back to RSS\n", \
                        last[idx["pss_fallback"]]
                hours = (e1 - e0 - gaps) / 3600
                if (hours > 0.5) {
                    printf "tree growth rate: %+.0f MB/hour", \
                        (last[idx["total_pss_mb"]] - first[idx["total_pss_mb"]]) / hours
                    if (gaps > 0) printf " (%d min of gaps excluded)", gaps / 60
                    printf "\n"
                }
            }
        ' "$HISTORY" ;;
    "") ;;
    *)  echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
esac

mkdir -p "$STATE_DIR" "$SNAP_DIR"
[[ -s $HISTORY ]] || csv_header >"$HISTORY"

if [[ ! -r /proc/self/smaps_rollup ]]; then
    echo "warning: /proc/self/smaps_rollup unreadable; falling back to RSS, which" >&2
    echo "         overstates a shared-memory process tree. Figures are approximate." >&2
fi

last_notify=0
while :; do
    if [[ -s $HISTORY ]] && (( $(stat -c %s "$HISTORY" 2>/dev/null || echo 0) > MAX_HISTORY_BYTES )); then
        mv -f "$HISTORY" "$HISTORY.1"
        csv_header >"$HISTORY"
    fi

    sample

    # Nothing running: don't fill the log with rows of zeros.
    if (( N_PROCS == 0 )); then
        sleep "$INTERVAL"
        continue
    fi

    csv_row >>"$HISTORY"

    total_mb=$(( SUM_PSS_KB / 1024 ))
    top_mb=$(( TOP_KB / 1024 ))
    printf -v now '%(%s)T' -1

    if (( total_mb >= WARN_TOTAL_MB || top_mb >= WARN_PROC_MB )) \
       && (( now - last_notify >= NOTIFY_COOLDOWN )); then
        printf -v snap_stamp '%(%Y%m%dT%H%M%S)T' -1
        snap="$SNAP_DIR/$snap_stamp.txt"
        {
            printf '# vscode-memory-watch %s snapshot %(%Y-%m-%dT%H:%M:%S%z)T\n' "$VERSION" -1
            printf '# %s' "$(summary_head)"
            summary_body | sed 's/^/# /'
            echo
            printf '%s\n' "${DETAIL[@]}"
        } >"$snap"

        notify-send -u critical -a "VS Code memory" \
            "VS Code at ${total_mb} MB" \
            "Largest: ${TOP_ROLE} (pid ${TOP_PID}) at ${top_mb} MB. ${N_CLAUDE} Claude session(s) open. Snapshot: ${snap}" \
            2>/dev/null
        last_notify=$now
    fi

    sleep "$INTERVAL"
done
